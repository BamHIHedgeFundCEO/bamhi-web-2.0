# ⚠️ 本地預覽開關：true = 略過 JWT 驗證讓前端直接拿到資料。
# 生產環境 (Render) 絕對不要設定此變數！
AUTH_DISABLED=true

# 你的 Supabase 專案網址 (JWKS 驗證用)，例 https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# 僅舊版 HS256 專案才需要；新版非對稱金鑰 (JWKS) 留空即可
SUPABASE_JWT_SECRET=

# 生產前端來源 (Vercel domain)，用於 CORS 白名單
FRONTEND_ORIGIN=https://bamhi-quant.vercel.app

# 既有 pipeline 用到的金鑰
POLYGON_API_KEY=
DISCORD_WEBHOOK=

# 內部人追蹤 (SEC EDGAR 免費，無需 API 金鑰) + Discord 通知
# SEC_USER_AGENT 格式：公司名 + 聯絡信箱 (SEC 規定)
SEC_USER_AGENT=BamHI Quant frank940702@gmail.com
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
INSIDER_MEGA_THRESHOLD=5000000   # 超大單即時警報門檻 (美元)
DIGEST_HOUR_EST=22               # 每日摘要推送時間 (美東時間，22 = 晚上 10 點)

# Insider cache 持久化 (Render Persistent Disk)
# 本地開發：留空 (預設寫 data/insider_cache.json)
# Render 生產：
#   1. Render Dashboard → 你的 Service → Disks → Add Disk
#   2. Mount Path: /mnt/data   Size: 1 GB ($0.25/月)
#   3. 在此設定：INSIDER_CACHE_DIR=/mnt/data
INSIDER_CACHE_DIR=
